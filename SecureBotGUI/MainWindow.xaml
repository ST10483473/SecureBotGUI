<Window x:Class="SecureBotGUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SecureBot - Cybersecurity Chatbot" Height="500" Width="800">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left half background (Yellow) -->
        <Rectangle Grid.Column="0" Fill="Yellow"/>

        <!-- Right half background (DarkBrown) -->
        <Rectangle Grid.Column="1" Fill="SaddleBrown"/>

        <!-- Crimson border outline on the left -->
        <Border BorderBrush="Crimson" BorderThickness="5" Grid.Column="0" Grid.RowSpan="2"/>

        <!-- Content overlay -->
        <StackPanel Grid.ColumnSpan="2" Margin="20">
            <!-- Title inside border -->
            <Border BorderBrush="Crimson" BorderThickness="3" Padding="10" Margin="0,0,0,15" Background="White">
                <TextBlock Text="SecureBot - Cybersecurity Chatbot"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="Crimson"
                           HorizontalAlignment="Center"/>
            </Border>

            <!-- Chat history -->
            <TextBox x:Name="ChatHistory"
                     Margin="0,0,0,10"
                     Height="200"
                     IsReadOnly="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     AcceptsReturn="True"
                     FontSize="14"/>

            <!-- User input -->
            <TextBox x:Name="UserInput"
                     Margin="0,0,0,10"
                     Height="40"
                     FontSize="14"
                     Text="Type your message here..."/>

            <!-- Send button -->
            <Button x:Name="SendButton"
                    Content="Send"
                    Width="120"
                    Height="45"
                    FontSize="16"
                    FontWeight="Bold"
                    Background="Crimson"
                    Foreground="White"
                    Click="SendButton_Click"
                    Margin="0,0,0,15"/>

            <!-- Feature buttons -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        Margin="0,0,0,10">
                <Button Content="Task Assistant"
                        Width="150" Height="45"
                        FontSize="16" FontWeight="Bold"
                        Background="OrangeRed" Foreground="White"
                        Margin="5" Click="TaskAssistant_Click"/>
                <Button Content="Quiz Game"
                        Width="150" Height="45"
                        FontSize="16" FontWeight="Bold"
                        Background="MediumPurple" Foreground="White"
                        Margin="5" Click="QuizGame_Click"/>
                <Button Content="Activity Log"
                        Width="150" Height="45"
                        FontSize="16" FontWeight="Bold"
                        Background="SteelBlue" Foreground="White"
                        Margin="5" Click="ActivityLog_Click"/>
                <Button Content="NLP Demo"
                        Width="150" Height="45"
                        FontSize="16" FontWeight="Bold"
                        Background="DarkOliveGreen" Foreground="White"
                        Margin="5" Click="NLP_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
