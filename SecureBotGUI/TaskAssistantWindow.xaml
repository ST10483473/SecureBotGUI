<Window x:Class="SecureBotGUI.TaskAssistantWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Task Assistant" Height="450" Width="650">

    <!-- Half-and-half background using Grid with two columns -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left half background (Yellow) -->
        <Rectangle Grid.Column="0" Fill="Yellow"/>

        <!-- Right half background (Dark Blue) -->
        <Rectangle Grid.Column="1" Fill="DarkBlue"/>

        <!-- Content overlay -->
        <StackPanel Grid.ColumnSpan="2" Margin="20">
            <!-- Title inside a border -->
            <Border BorderBrush="Black" BorderThickness="2" Padding="10" Margin="0,0,0,15" Background="White">
                <TextBlock Text="Cybersecurity Task Assistant"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="Black"
                           HorizontalAlignment="Center"/>
            </Border>

            <!-- Task title -->
            <TextBox x:Name="TaskTitle"
                     Margin="0,0,0,10"
                     Height="35"
                     FontSize="14"
                     Text="Enter task title..."/>

            <!-- Task details (multi-line typing area) -->
            <TextBox x:Name="TaskDetails"
                     Margin="0,0,0,10"
                     Height="80"
                     FontSize="14"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     Text="Enter task details..."/>

            <!-- Reminder date -->
            <DatePicker x:Name="ReminderDate"
                        Margin="0,0,0,15"
                        Height="35"/>

            <!-- Bulky buttons -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,15">
                <Button Content="Add Task"
                        Width="150"
                        Height="45"
                        FontSize="16"
                        FontWeight="Bold"
                        Background="Orange"
                        Foreground="White"
                        Click="AddTask_Click"
                        Margin="10"/>
                <Button Content="Clear Tasks"
                        Width="150"
                        Height="45"
                        FontSize="16"
                        FontWeight="Bold"
                        Background="Red"
                        Foreground="White"
                        Margin="10"/>
            </StackPanel>

            <!-- Task list -->
            <ListBox x:Name="TaskList"
                     Margin="0,10,0,0"
                     Height="150"
                     FontSize="14"/>
        </StackPanel>
    </Grid>
</Window>
