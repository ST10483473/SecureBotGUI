<Window x:Class="SecureBotGUI.NLPWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NLP Demo" Height="300" Width="500">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Rectangle Grid.Column="0" Fill="Teal"/>
        <Rectangle Grid.Column="1" Fill="Gray"/>

        <StackPanel Grid.ColumnSpan="2" Margin="20">
            <Border BorderBrush="Black" BorderThickness="2" Padding="10" Margin="0,0,0,15" Background="White">
                <TextBlock Text="Natural Language Processing Demo"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="Black"
                           HorizontalAlignment="Center"/>
            </Border>

            <TextBox x:Name="NLPInput"
                     Height="60"
                     FontSize="14"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     Margin="0,0,0,10"
                     Text="Enter text here..."/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,15">
                <Button Content="Process"
                        Width="150"
                        Height="45"
                        FontSize="16"
                        FontWeight="Bold"
                        Background="DarkBlue"
                        Foreground="White"
                        Click="Process_Click"
                        Margin="10"/>
                <Button Content="Clear"
                        Width="150"
                        Height="45"
                        FontSize="16"
                        FontWeight="Bold"
                        Background="Red"
                        Foreground="White"
                        Margin="10"/>
            </StackPanel>

            <TextBlock x:Name="NLPResult"
                       FontSize="14"
                       Foreground="White"
                       Text="Result will appear here."
                       TextWrapping="Wrap"
                       Margin="0,10,0,0"/>
        </StackPanel>
    </Grid>
</Window>
