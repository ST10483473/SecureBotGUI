<Window x:Class="SecureBotGUI.QuizWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quiz Game" Height="500" Width="700">

    <!-- Gradient background for shiny effect -->
    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="Yellow" Offset="0.0"/>
                <GradientStop Color="SaddleBrown" Offset="1.0"/>
            </LinearGradientBrush>
        </Grid.Background>

        <!-- Crimson border outline -->
        <Border BorderBrush="Crimson" BorderThickness="5" Margin="10">
            <StackPanel Margin="20">
                <!-- Title inside border -->
                <Border BorderBrush="Crimson" BorderThickness="3" Padding="10" Margin="0,0,0,15" Background="White">
                    <TextBlock Text="Cybersecurity Quiz Game"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="Crimson"
                               HorizontalAlignment="Center"/>
                </Border>

                <!-- Difficulty selector -->
                <ComboBox x:Name="DifficultySelector" Width="200" Margin="0,0,0,10">
                    <ComboBoxItem Content="Easy"/>
                    <ComboBoxItem Content="Medium"/>
                    <ComboBoxItem Content="Hard"/>
                    <ComboBoxItem Content="Endless"/>
                </ComboBox>

                <!-- Question text -->
                <TextBlock x:Name="QuestionText"
                           FontSize="16"
                           Foreground="White"
                           Margin="0,0,0,10"/>

                <!-- Answer options -->
                <StackPanel>
                    <RadioButton x:Name="Option1" Content="Option 1" Margin="0,5,0,0"/>
                    <RadioButton x:Name="Option2" Content="Option 2" Margin="0,5,0,0"/>
                    <RadioButton x:Name="Option3" Content="Option 3" Margin="0,5,0,0"/>
                    <RadioButton x:Name="Option4" Content="Option 4" Margin="0,5,0,0"/>
                </StackPanel>

                <!-- Bulky shiny buttons -->
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0" HorizontalAlignment="Center">
                    <Button Content="Start Quiz"
                            Width="150" Height="45"
                            FontSize="16" FontWeight="Bold"
                            Background="OrangeRed" Foreground="White"
                            BorderBrush="Gold" BorderThickness="2"
                            Click="StartQuiz_Click"
                            Margin="10"/>
                    <Button Content="Submit Answer"
                            Width="150" Height="45"
                            FontSize="16" FontWeight="Bold"
                            Background="SteelBlue" Foreground="White"
                            BorderBrush="LightYellow" BorderThickness="2"
                            Click="SubmitAnswer_Click"
                            Margin="10"/>
                </StackPanel>

                <!-- Result text -->
                <TextBlock x:Name="ResultText"
                           FontSize="14"
                           Foreground="Yellow"
                           Margin="0,10,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
