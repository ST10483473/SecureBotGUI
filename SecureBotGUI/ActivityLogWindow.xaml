<Window x:Class="SecureBotGUI.ActivityLogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Activity Log" Height="400" Width="600">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left half background (Silver) -->
        <Rectangle Grid.Column="0" Fill="Silver"/>

        <!-- Right half background (Orange) -->
        <Rectangle Grid.Column="1" Fill="Orange"/>

        <!-- Content overlay -->
        <StackPanel Grid.ColumnSpan="2" Margin="20">
            <!-- Title inside border -->
            <Border BorderBrush="Black" BorderThickness="2" Padding="10" Margin="0,0,0,15" Background="White">
                <TextBlock Text="Activity Log"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="Black"
                           HorizontalAlignment="Center"/>
            </Border>

            <!-- Log list -->
            <ListBox x:Name="LogList"
                     Height="200"
                     FontSize="14"
                     Margin="0,0,0,15"/>

            <!-- Bulky buttons -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="Clear Log"
                        Width="150"
                        Height="45"
                        FontSize="16"
                        FontWeight="Bold"
                        Background="Red"
                        Foreground="White"
                        Click="ClearLog_Click"
                        Margin="10"/>
                <Button Content="Export Log"
                        Width="150"
                        Height="45"
                        FontSize="16"
                        FontWeight="Bold"
                        Background="DarkGreen"
                        Foreground="White"
                        Margin="10"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
